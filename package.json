{
  "name": "qamachine",
  "version": "0.1.0",
  "description": "Blackbox Playwright-powered CLI for recording user journeys, saving them as reusable templates, grouping them into playbooks, and running them under locally-registered user profiles.",
  "type": "module",
  "bin": {
    "qamachine": "./dist/bin/qamachine.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx bin/qamachine.ts",
    "test": "vitest run",
    "test:e2e-adapters": "vitest run --config vitest.e2e-adapters.config.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@playwright/test": "^1.48.0",
    "acorn": "^8.14.0",
    "acorn-walk": "^8.3.4",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-boundaries": "^4.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
